# Public browser configuration — safe to expose only with the VITE_ prefix.
VITE_SUPABASE_URL=[REDACTED]
VITE_SUPABASE_PUBLISHABLE_KEY=[REDACTED]
VITE_SUPABASE_PROJECT_ID=[REDACTED]

# Server-side Supabase configuration — do not use VITE_ prefixes.
SUPABASE_URL=[REDACTED]
SUPABASE_ANON_KEY=[REDACTED]
SUPABASE_SERVICE_ROLE_KEY=[REDACTED]

# Public canonical site URL, HTTPS only, without a trailing slash.
# Use the deployed test domain for test keys and production domain for live keys.
PUBLIC_SITE_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example

# Yoco Checkout — server-side only. Never commit real values or expose through VITE_.
# Use sk_test_... until all end-to-end tests pass; only then use sk_live_....
YOCO_SECRET_KEY=[REDACTED]
# Set only after Yoco returns the one-time webhook secret during webhook registration.
YOCO_WEBHOOK_SECRET=[REDACTED]
